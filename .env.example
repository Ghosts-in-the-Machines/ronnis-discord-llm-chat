# Discord bot connection.
DISCORD_BOT_TOKEN=

# Optional comma-separated allowlist. Leave blank to allow every guild the bot can see.
DISCORD_GUILD_IDS=

# Optional primary human account metadata.
DISCORD_PRIMARY_USER_ID=
HUMAN=the primary user

# Worker identity stored in local state files.
NAME=discord-llm-worker

# API endpoint.
# API_PROVIDER: 'openai', 'anthropic', 'openrouter', or 'auto'.
# 'auto' will attempt to detect based on the BASE_URL.
# DeepSeek can use https://api.deepseek.com or https://api.deepseek.com/v1.
# Native Claude can use API_PROVIDER=anthropic and https://api.anthropic.com.
# Local OpenAI-compatible servers commonly use http://localhost:8000.
# OpenRouter uses the OpenAI-compatible payload plus HTTP-Referer and X-Title headers.
API_PROVIDER=auto
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=your_key_here
MODEL=anthropic/claude-3.5-sonnet
# Agent response decision mode. auto uses JSON for high/advanced models and [ACK] for standard/low/quantized models.
# MODEL_TIER: auto, high, low, quantized
# MODEL_CAPABILITY: auto, standard, advanced
# ACK_MODE: auto, json, keyword, off
# PROMPT_MODE: auto or direct. Use direct for local/quantized RP models that leak planning/thinking text.
MODEL_TIER=auto
MODEL_CAPABILITY=auto
ACK_MODE=auto
ACK_KEYWORD=[ACK]
PROMPT_MODE=auto
OPENROUTER_HTTP_REFERER=https://discord-llm-chat.local
OPENROUTER_X_TITLE=Ronni's Discord LLM Chat
CHAT_TEMP=0.7
MAX_TOKENS=1200

# Optional generation controls. Leave blank to omit params unsupported by a backend.
SEED=
TOP_P=
TOP_K=
MIN_P=
FREQUENCY_PENALTY=
PRESENCE_PENALTY=
REPETITION_PENALTY=
# Optional reasoning model parameter for compatible OpenAI-style providers.
# Leave blank/off/none/omit to omit the param for maximum compatibility.
# Use REASONING=false only for providers that support explicit JSON false.
# OpenRouter omits boolean values and sends string values as {"effort":"..."}.
# For OpenRouter, use REASONING={"effort":"none"} to request reasoning off.
# Bare REASONING=none means omit the parameter, not OpenRouter effort:none.
# Examples: REASONING=medium, REASONING={"effort":"medium"}, or REASONING={"effort":"none"}
REASONING=
# Optional JSON object merged into OpenAI-compatible request bodies.
# Useful for local servers with template-specific switches.
# Example: OPENAI_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
OPENAI_EXTRA_BODY=
# Strip visible <think>...</think>, <thinking>...</thinking>, and similar wrappers from LLM replies.
STRIP_THINKING_BLOCKS=true

# Local runtime data.
# For Docker/Compose, DATA_ROOT is overridden to /app/data.
DATA_ROOT=./data
# Old chat lines rotate to CHAT_ARCHIVE_ROOT once an active chat log exceeds this many JSONL rows.
# Set CHAT_ARCHIVE_MAX_LINES=0 to disable rotation. Docker default is /app/data/archive.
CHAT_ARCHIVE_ROOT=
CHAT_ARCHIVE_MAX_LINES=5000
PULSE_INTERVAL=180
MAX_STEPS=5
PULSE_BUDGET=5
CTX_LIMIT=10000

# Optional proactive Discord prompt. Leave MESSAGE_FIRST_TIMER blank to disable.
# Timer is a silence threshold in minutes. Leave MESSAGE_FIRST_CHANNEL_IDS blank
# to pick a random visible channel that has been silent long enough.
MESSAGE_FIRST_TIMER=
MESSAGE_FIRST_CHANNEL_IDS=

# Default false for safety. Set true only if you want the bot to respond to other bots.
REPLY_TO_BOTS=false

# Optional SillyTavern-style character card JSON export or PNG card.
# Leave blank, none, off, or false to disable character cards.
# For Docker/Compose, mount files under ./character_cards and use /app/character_cards/card.png.
CHARACTER_CARD=

# Lorebooks are disabled by default. Set to ./lorebooks to enable JSON keyword context.
# For Docker/Compose, mount files under ./lorebooks and use /app/lorebooks.
LOREBOOK_ROOT=none

# Optional memory retrieval. USE_MEM must be true before any memory provider is queried.
USE_MEM=false

# Valid providers: none, generic, qdrant, supabase, local:path/to/memories.json
# For Docker/Compose local memory, mount ./memory and use local:/app/memory/memories.json.
MEMORY_PROVIDER=none
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.0

# Generic memory endpoint. Expected request: {"query":"...","top_k":5}.
# Expected response can contain memories/results/documents/data as strings or objects with content/text/memory/body.
MEMORY_API_URL=
MEMORY_API_KEY=

# Qdrant memory retrieval requires an embedding endpoint that returns OpenAI-style embeddings.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_NAME=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Supabase memory retrieval can use either RPC or a simple ilike table lookup.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=memories
SUPABASE_TEXT_COLUMN=content
SUPABASE_RPC=
