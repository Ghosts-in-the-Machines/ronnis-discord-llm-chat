# Discord bot connection.
DISCORD_BOT_TOKEN=

# Optional comma-separated allowlist. Leave blank to allow every guild the bot can see.
DISCORD_GUILD_IDS=

# Optional primary human account metadata.
DISCORD_PRIMARY_USER_ID=
HUMAN=the primary user

# Worker identity stored in local state files.
NAME=discord-llm-worker

# OpenAI-compatible API endpoint.
# DeepSeek can use https://api.deepseek.com or https://api.deepseek.com/v1.
# Local OpenAI-compatible servers commonly use http://localhost:8000.
API_BASE_URL=http://localhost:8000
API_KEY=
MODEL=gpt-4o-mini
CHAT_TEMP=0.7
MAX_TOKENS=1200

# Optional generation controls. Leave blank to omit params unsupported by a backend.
SEED=
TOP_P=
TOP_K=
MIN_P=
FREQUENCY_PENALTY=
PRESENCE_PENALTY=
REPETITION_PENALTY=

# Local runtime data.
DATA_ROOT=./data
PULSE_INTERVAL=180
MAX_STEPS=5
PULSE_BUDGET=5
CTX_LIMIT=10000

# Default false for safety. Set true only if you want the bot to respond to other bots.
REPLY_TO_BOTS=false

# Optional SillyTavern-style character card JSON export or PNG card.
# Leave blank, none, off, or false to disable character cards.
CHARACTER_CARD=

# Lorebooks are disabled by default. Set to ./lorebooks to enable JSON keyword context.
LOREBOOK_ROOT=none

# Optional memory retrieval. USE_MEM must be true before any memory provider is queried.
USE_MEM=false

# Valid providers: none, generic, qdrant, supabase, local:path/to/memories.json
MEMORY_PROVIDER=none
MEMORY_TOP_K=5
MEMORY_MIN_SCORE=0.0

# Generic memory endpoint. Expected request: {"query":"...","top_k":5}.
# Expected response can contain memories/results/documents/data as strings or objects with content/text/memory/body.
MEMORY_API_URL=
MEMORY_API_KEY=

# Qdrant memory retrieval requires an embedding endpoint that returns OpenAI-style embeddings.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_NAME=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Supabase memory retrieval can use either RPC or a simple ilike table lookup.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=memories
SUPABASE_TEXT_COLUMN=content
SUPABASE_RPC=
